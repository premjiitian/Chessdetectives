{
  "name": "chess-detectives",
  "version": "0.1.0",
  "private": true,
  "description": "Learn from your own chess.com mistakes: personal puzzles, a Stockfish sparring partner and a friendly coach.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "engine": "node scripts/copy-engine.mjs",
    "dev": "npm run engine && vite",
    "build": "npm run engine && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node tests/e2e.mjs",
    "loop": "node scripts/loop.mjs"
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "^1.0.3",
    "@lichess-org/chessground": "10.5.0",
    "chess.js": "1.4.0",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
